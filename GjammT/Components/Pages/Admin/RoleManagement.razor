    }

    .permission-flags {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.5rem;
    }

    .checkbox-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: normal;
        cursor: pointer;
        color: #4b5563;
    }

    .checkbox-label input[type="checkbox"] {
