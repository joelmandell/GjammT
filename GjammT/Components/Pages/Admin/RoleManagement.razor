@page "/gjadmin/roles"
@using GjammT.Components.Layout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@layout AdminLayout
@using GjammT.Models.Base
@using GjammT.Models.Data
@inject IDbContextFactory<AppDbContext> ContextFactory

<PageTitle>Role Management - GjammT Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Role Management</h1>
            <p class="page-description">Define and manage user roles with permissions</p>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <span>+</span> Add Role
        </button>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading roles...</div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">@errorMessage</div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Role Name</th>
                        <th>Description</th>
                        <th>Permissions</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in roles)
                    {
                        <tr>
                            <td><strong>@role.Name</strong></td>
                            <td>@role.Description</td>
                            <td>
                                @if (role.Permissions.Any())
                                {
                                    <span class="badge badge-info">@role.Permissions.Count permission group(s)</span>
                                }
                                else
                                {
                                    <span class="badge badge-warning">No permissions</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-info" @onclick="() => ShowPermissionsDialog(role)">Permissions</button>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditDialog(role)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteDialog(role)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Edit Role" : "Add New Role")</h2>
                <button class="modal-close" @onclick="CloseDialog">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Role Name *</label>
                    <input type="text" class="form-control" @bind="currentRole.Name" placeholder="e.g., Administrator, Agent, Viewer" />
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <textarea class="form-control" rows="3" @bind="currentRole.Description" placeholder="Describe what this role can do"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveRole" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@if (showPermissionsDialog)
{
    <div class="modal-overlay" @onclick="ClosePermissionsDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Manage Permissions: @selectedRole?.Name</h2>
                <button class="modal-close" @onclick="ClosePermissionsDialog">×</button>
            </div>
            <div class="modal-body">
                @if (permissionGroups.Any())
                {
                    <div class="permissions-grid">
                        @foreach (var group in permissionGroups)
                        {
                            var rolePermission = selectedRolePermissions.FirstOrDefault(rp => rp.PermissionGroupId == group.Id);
                            <div class="permission-item">
                                <div class="permission-header">
                                    <strong>@group.Name</strong>
                                </div>
                                <div class="permission-flags">
                                    <label class="checkbox-label">
                                        <input type="checkbox" 
                                               checked="@HasPermission(rolePermission, PermissionFlags.CanRead)"
                                               @onchange="e => TogglePermission(group.Id, PermissionFlags.CanRead, (bool)e.Value!)" />
                                        Can Read
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" 
                                               checked="@HasPermission(rolePermission, PermissionFlags.CanCreate)"
                                               @onchange="e => TogglePermission(group.Id, PermissionFlags.CanCreate, (bool)e.Value!)" />
                                        Can Create
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" 
                                               checked="@HasPermission(rolePermission, PermissionFlags.CanWrite)"
                                               @onchange="e => TogglePermission(group.Id, PermissionFlags.CanWrite, (bool)e.Value!)" />
                                        Can Write
                                    </label>
                                    <label class="checkbox-label">
                                        <input type="checkbox" 
                                               checked="@HasPermission(rolePermission, PermissionFlags.CanDelete)"
                                               @onchange="e => TogglePermission(group.Id, PermissionFlags.CanDelete, (bool)e.Value!)" />
                                        Can Delete
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="no-data">No permission groups available. Create permission groups first.</p>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="ClosePermissionsDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePermissions" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save Permissions")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirm Delete</h2>
                <button class="modal-close" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@roleToDelete?.Name</strong>?</p>
                <p class="warning-text">This will affect all users assigned to this role.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteRole" disabled="@isSaving">
                    @(isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<Role> roles = new();
    private List<PermissionGroup> permissionGroups = new();
    private List<RolePermission> selectedRolePermissions = new();
    private Role currentRole = new();
    private Role? roleToDelete;
    private Role? selectedRole;
    private bool showDialog = false;
    private bool showPermissionsDialog = false;
    private bool showDeleteDialog = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadRoles();
        await LoadPermissionGroups();
    }

    private async Task LoadRoles()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            await using var context = await ContextFactory.CreateDbContextAsync();
            roles = await context.Roles
                .Include(r => r.Permissions)
                .OrderBy(r => r.Name)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading roles: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPermissionGroups()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            permissionGroups = await context.PermissionGroups.OrderBy(pg => pg.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading permission groups: {ex.Message}";
        }
    }

    private async Task ShowPermissionsDialog(Role role)
    {
        selectedRole = role;
        await LoadRolePermissions(role.Id);
        showPermissionsDialog = true;
    }

    private async Task LoadRolePermissions(Guid roleId)
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            selectedRolePermissions = await context.RolePermissions
                .Where(rp => rp.RoleId == roleId)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading role permissions: {ex.Message}";
        }
    }

    private bool HasPermission(RolePermission? rolePermission, PermissionFlags flag)
    {
        if (rolePermission == null) return false;
        return (rolePermission.AllowedActions & (int)flag) != 0;
    }

    private void TogglePermission(Guid permissionGroupId, PermissionFlags flag, bool enabled)
    {
        var rolePermission = selectedRolePermissions.FirstOrDefault(rp => rp.PermissionGroupId == permissionGroupId);
        
        if (rolePermission == null && enabled)
        {
            rolePermission = new RolePermission
            {
                Id = Guid.NewGuid(),
                RoleId = selectedRole!.Id,
                PermissionGroupId = permissionGroupId,
                AllowedActions = (int)flag
            };
            selectedRolePermissions.Add(rolePermission);
        }
        else if (rolePermission != null)
        {
            if (enabled)
            {
                rolePermission.AllowedActions |= (int)flag;
            }
            else
            {
                rolePermission.AllowedActions &= ~(int)flag;
            }
        }
    }

    private async Task SavePermissions()
    {
        if (selectedRole == null) return;

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();

            // Remove existing permissions for this role
            var existingPermissions = await context.RolePermissions
                .Where(rp => rp.RoleId == selectedRole.Id)
                .ToListAsync();
            context.RolePermissions.RemoveRange(existingPermissions);

            // Add updated permissions (only those with at least one flag set)
            var validPermissions = selectedRolePermissions.Where(rp => rp.AllowedActions > 0).ToList();
            await context.RolePermissions.AddRangeAsync(validPermissions);

            await context.SaveChangesAsync();
            await LoadRoles();
            ClosePermissionsDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving permissions: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowAddDialog()
    {
        currentRole = new Role();
        isEditing = false;
        showDialog = true;
    }

    private void ShowEditDialog(Role role)
    {
        currentRole = new Role
        {
            Id = role.Id,
            Name = role.Name,
            Description = role.Description
        };
        isEditing = true;
        showDialog = true;
    }

    private void ShowDeleteDialog(Role role)
    {
        roleToDelete = role;
        showDeleteDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        currentRole = new Role();
    }

    private void ClosePermissionsDialog()
    {
        showPermissionsDialog = false;
        selectedRole = null;
        selectedRolePermissions.Clear();
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        roleToDelete = null;
    }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(currentRole.Name))
        {
            return;
        }

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();

            if (isEditing)
            {
                var existing = await context.Roles.FindAsync(currentRole.Id);
                if (existing != null)
                {
                    existing.Name = currentRole.Name;
                    existing.Description = currentRole.Description;
                }
            }
            else
            {
                currentRole.Id = Guid.NewGuid();
                await context.Roles.AddAsync(currentRole);
            }

            await context.SaveChangesAsync();
            await LoadRoles();
            CloseDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving role: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteRole()
    {
        if (roleToDelete == null) return;

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();
            var role = await context.Roles.FindAsync(roleToDelete.Id);
            if (role != null)
            {
                context.Roles.Remove(role);
                await context.SaveChangesAsync();
                await LoadRoles();
            }
            CloseDeleteDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting role: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

<style>
    .page-container {
        max-width: 1400px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
