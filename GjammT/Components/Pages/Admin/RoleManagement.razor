    }

    .btn-info {
        background: #0891b2;
        color: white;
    }

    .btn-info:hover:not(:disabled) {
        background: #0e7490;
    }

    .btn-danger {
        background: #dc2626;
        color: white;
    }

    .btn-danger:hover:not(:disabled) {
        background: #b91c1c;
    }

    .btn-sm {
