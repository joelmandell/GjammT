@page "/gjadmin/permissions"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@layout AdminLayout
@using GjammT.Models.Base
@using GjammT.Models.Data
@inject IDbContextFactory<AppDbContext> ContextFactory

<PageTitle>Permission Management - GjammT Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">Permission Group Management</h1>
            <p class="page-description">Define resources and features that can be protected with permissions</p>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <span>+</span> Add Permission Group
        </button>
    </div>

    <div class="info-box">
        <h3>What are Permission Groups?</h3>
        <p>
            Permission groups represent resources or features in your application (e.g., "Products", "Invoices", "Settings").
            Each group can have different permission flags (Read, Create, Write, Delete) assigned through roles.
        </p>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading permission groups...</div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">@errorMessage</div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Group Name</th>
                        <th>ID</th>
                        <th>Used in Roles</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var group in permissionGroups)
                    {
                        <tr>
                            <td><strong>@group.Name</strong></td>
                            <td><code>@group.Id</code></td>
                            <td>
                                @{
                                    var rolesCount = rolePermissions.Count(rp => rp.PermissionGroupId == group.Id);
                                }
                                @if (rolesCount > 0)
                                {
                                    <span class="badge badge-info">@rolesCount role(s)</span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">Not used</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditDialog(group)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteDialog(group)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Edit Permission Group" : "Add New Permission Group")</h2>
                <button class="modal-close" @onclick="CloseDialog">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Group Name *</label>
                    <input type="text" class="form-control" @bind="currentGroup.Name" placeholder="e.g., Products, Invoices, Bookings" />
                    <small class="form-text">The name of the resource or feature to protect</small>
                </div>
                <div class="info-section">
                    <h4>Available Permission Flags</h4>
                    <ul>
                        <li><strong>CanRead</strong> - View/read the resource</li>
                        <li><strong>CanCreate</strong> - Create new items</li>
                        <li><strong>CanWrite</strong> - Update existing items</li>
                        <li><strong>CanDelete</strong> - Delete items</li>
                    </ul>
                    <p class="note">These flags will be assigned to roles in the Role Management section.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveGroup" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirm Delete</h2>
                <button class="modal-close" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>@groupToDelete?.Name</strong>?</p>
                @{
                    var rolesUsing = rolePermissions.Count(rp => rp.PermissionGroupId == groupToDelete?.Id);
                }
                @if (rolesUsing > 0)
                {
                    <p class="warning-text">Warning: This permission group is used by @rolesUsing role(s). Deleting it will remove these permissions.</p>
                }
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteGroup" disabled="@isSaving">
                    @(isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PermissionGroup> permissionGroups = new();
    private List<RolePermission> rolePermissions = new();
    private PermissionGroup currentGroup = new();
    private PermissionGroup? groupToDelete;
    private bool showDialog = false;
    private bool showDeleteDialog = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissionGroups();
        await LoadRolePermissions();
    }

    private async Task LoadPermissionGroups()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            await using var context = await ContextFactory.CreateDbContextAsync();
            permissionGroups = await context.PermissionGroups.OrderBy(pg => pg.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading permission groups: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadRolePermissions()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            rolePermissions = await context.RolePermissions.ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading role permissions: {ex.Message}";
        }
    }

    private void ShowAddDialog()
    {
        currentGroup = new PermissionGroup();
        isEditing = false;
        showDialog = true;
    }

    private void ShowEditDialog(PermissionGroup group)
    {
        currentGroup = new PermissionGroup
        {
            Id = group.Id,
            Name = group.Name
        };
        isEditing = true;
        showDialog = true;
    }

    private void ShowDeleteDialog(PermissionGroup group)
    {
        groupToDelete = group;
        showDeleteDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        currentGroup = new PermissionGroup();
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        groupToDelete = null;
    }

    private async Task SaveGroup()
    {
        if (string.IsNullOrWhiteSpace(currentGroup.Name))
        {
            return;
        }

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();

            if (isEditing)
            {
                var existing = await context.PermissionGroups.FindAsync(currentGroup.Id);
                if (existing != null)
                {
                    existing.Name = currentGroup.Name;
                }
            }
            else
            {
                currentGroup.Id = Guid.NewGuid();
                await context.PermissionGroups.AddAsync(currentGroup);
            }

            await context.SaveChangesAsync();
            await LoadPermissionGroups();
            CloseDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving permission group: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteGroup()
    {
        if (groupToDelete == null) return;

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();
            var group = await context.PermissionGroups.FindAsync(groupToDelete.Id);
            if (group != null)
            {
                context.PermissionGroups.Remove(group);
                await context.SaveChangesAsync();
                await LoadPermissionGroups();
                await LoadRolePermissions();
            }
            CloseDeleteDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting permission group: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

