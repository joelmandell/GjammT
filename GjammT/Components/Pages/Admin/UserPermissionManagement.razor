@page "/gjadmin/userpermissions"
@using GjammT.Components.Layout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@layout AdminLayout
@using GjammT.Models.Base
@using GjammT.Models.CustomerRegister
@using GjammT.Models.Data
@inject IDbContextFactory<AppDbContext> ContextFactory

<PageTitle>User Permission Management - GjammT Admin</PageTitle>

<div class="page-container">
    <div class="page-header">
        <div>
            <h1 class="page-title">User Permission Management</h1>
            <p class="page-description">Manage user-level permissions linked to customers or tenants</p>
        </div>
        <button class="btn btn-primary" @onclick="ShowAddDialog">
            <span>+</span> Add User Permission
        </button>
    </div>

    <div class="info-box">
        <h3>What are User Permissions?</h3>
        <p>
            User permissions allow you to grant specific permissions to individual users for particular customers or tenants.
            These permissions override or extend role-based permissions, providing fine-grained access control.
        </p>
    </div>

    <div class="filters">
        <div class="filter-group">
            <label>Filter by User</label>
            <select class="form-control" @bind="selectedUserId" @bind:after="LoadUserPermissions">
                <option value="">All Users</option>
                @foreach (var user in users)
                {
                    <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                }
            </select>
        </div>
        <div class="filter-group">
            <label>Filter by Tenant</label>
            <select class="form-control" @bind="selectedTenantId" @bind:after="LoadUserPermissions">
                <option value="">All Tenants</option>
                @foreach (var tenant in tenants)
                {
                    <option value="@tenant.Id">@tenant.CompanyName</option>
                }
            </select>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="loading">Loading user permissions...</div>
    }
    else if (errorMessage != null)
    {
        <div class="error-message">@errorMessage</div>
    }
    else
    {
        <div class="table-container">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Scope</th>
                        <th>Permission Group</th>
                        <th>Permissions</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (userPermissions.Count == 0)
                    {
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 2rem; color: #6b7280;">
                                No user permissions found. Click "Add User Permission" to create one.
                            </td>
                        </tr>
                    }
                    @foreach (var perm in userPermissions)
                    {
                        <tr>
                            <td>
                                @{
                                    var user = users.FirstOrDefault(u => u.Id == perm.UserId);
                                }
                                <strong>@user?.FirstName @user?.LastName</strong>
                                <br/><small>@user?.Email</small>
                            </td>
                            <td>
                                @if (perm.CustomerId.HasValue)
                                {
                                    var customer = customers.FirstOrDefault(c => c.Id == perm.CustomerId.Value);
                                    <span class="badge badge-customer">Customer: @customer?.Name</span>
                                }
                                else if (perm.ClientCustomerId.HasValue)
                                {
                                    var tenant = tenants.FirstOrDefault(t => t.Id == perm.ClientCustomerId.Value);
                                    <span class="badge badge-tenant">Tenant: @tenant?.CompanyName</span>
                                }
                                else
                                {
                                    <span class="badge badge-global">Global</span>
                                }
                            </td>
                            <td>
                                @{
                                    var group = permissionGroups.FirstOrDefault(pg => pg.Id == perm.PermissionGroupId);
                                }
                                <strong>@group?.Name</strong>
                            </td>
                            <td>
                                @{
                                    var flags = (PermissionFlags)perm.AllowedActions;
                                    var flagList = new List<string>();
                                    if (flags.HasFlag(PermissionFlags.CanRead)) flagList.Add("Read");
                                    if (flags.HasFlag(PermissionFlags.CanCreate)) flagList.Add("Create");
                                    if (flags.HasFlag(PermissionFlags.CanWrite)) flagList.Add("Write");
                                    if (flags.HasFlag(PermissionFlags.CanDelete)) flagList.Add("Delete");
                                }
                                @string.Join(", ", flagList)
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(perm.Notes))
                                {
                                    <span title="@perm.Notes">@(perm.Notes.Length > 50 ? perm.Notes.Substring(0, 50) + "..." : perm.Notes)</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-secondary" @onclick="() => ShowEditDialog(perm)">Edit</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => ShowDeleteDialog(perm)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showDialog)
{
    <div class="modal-overlay" @onclick="CloseDialog">
        <div class="modal-content modal-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(isEditing ? "Edit User Permission" : "Add New User Permission")</h2>
                <button class="modal-close" @onclick="CloseDialog">×</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>User *</label>
                    <select class="form-control" @bind="currentPermission.UserId">
                        <option value="">Select a user</option>
                        @foreach (var user in users)
                        {
                            <option value="@user.Id">@user.FirstName @user.LastName (@user.Email)</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Scope Level *</label>
                    <select class="form-control" @bind="scopeLevel" @bind:after="OnScopeLevelChanged">
                        <option value="customer">Customer Level</option>
                        <option value="tenant">Tenant Level</option>
                        <option value="global">Global</option>
                    </select>
                    <small class="form-text">Choose whether this permission applies to a specific customer, tenant, or globally</small>
                </div>

                @if (scopeLevel == "tenant")
                {
                    <div class="form-group">
                        <label>Tenant *</label>
                        <select class="form-control" @bind="currentPermission.ClientCustomerId" @bind:after="OnTenantChanged">
                            <option value="">Select a tenant</option>
                            @foreach (var tenant in tenants)
                            {
                                <option value="@tenant.Id">@tenant.CompanyName</option>
                            }
                        </select>
                    </div>
                }

                @if (scopeLevel == "customer")
                {
                    <div class="form-group">
                        <label>Tenant *</label>
                        <select class="form-control" @bind="selectedTenantForCustomer" @bind:after="LoadCustomersForTenant">
                            <option value="">Select a tenant first</option>
                            @foreach (var tenant in tenants)
                            {
                                <option value="@tenant.Id">@tenant.CompanyName</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Customer *</label>
                        <select class="form-control" @bind="currentPermission.CustomerId" disabled="@string.IsNullOrEmpty(selectedTenantForCustomer)">
                            <option value="">Select a customer</option>
                            @foreach (var customer in filteredCustomers)
                            {
                                <option value="@customer.Id">@customer.Name</option>
                            }
                        </select>
                    </div>
                }

                <div class="form-group">
                    <label>Permission Group *</label>
                    <select class="form-control" @bind="currentPermission.PermissionGroupId">
                        <option value="">Select a permission group</option>
                        @foreach (var group in permissionGroups)
                        {
                            <option value="@group.Id">@group.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Allowed Actions *</label>
                    <div class="checkbox-group">
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="canRead" />
                            Can Read
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="canCreate" />
                            Can Create
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="canWrite" />
                            Can Write
                        </label>
                        <label class="checkbox-label">
                            <input type="checkbox" @bind="canDelete" />
                            Can Delete
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label>Notes</label>
                    <textarea class="form-control" @bind="currentPermission.Notes" rows="3" placeholder="Optional notes about why this permission was granted"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDialog">Cancel</button>
                <button class="btn btn-primary" @onclick="SavePermission" disabled="@isSaving">
                    @(isSaving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@if (showDeleteDialog)
{
    <div class="modal-overlay" @onclick="CloseDeleteDialog">
        <div class="modal-content modal-small" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Confirm Delete</h2>
                <button class="modal-close" @onclick="CloseDeleteDialog">×</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this user permission?</p>
                <p class="warning-text">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseDeleteDialog">Cancel</button>
                <button class="btn btn-danger" @onclick="DeletePermission" disabled="@isSaving">
                    @(isSaving ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserPermission> userPermissions = new();
    private List<User> users = new();
    private List<ClientCustomer> tenants = new();
    private List<Customer> customers = new();
    private List<Customer> filteredCustomers = new();
    private List<PermissionGroup> permissionGroups = new();
    
    private UserPermission currentPermission = new();
    private UserPermission? permissionToDelete;
    private bool showDialog = false;
    private bool showDeleteDialog = false;
    private bool isEditing = false;
    private bool isLoading = true;
    private bool isSaving = false;
    private string? errorMessage;
    
    private string selectedUserId = "";
    private string selectedTenantId = "";
    private string selectedTenantForCustomer = "";
    private string scopeLevel = "customer";
    
    private bool canRead = false;
    private bool canCreate = false;
    private bool canWrite = false;
    private bool canDelete = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadTenants();
        await LoadCustomers();
        await LoadPermissionGroups();
        await LoadUserPermissions();
    }

    private async Task LoadUsers()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            users = await context.Users.OrderBy(u => u.FirstName).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading users: {ex.Message}";
        }
    }

    private async Task LoadTenants()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            tenants = await context.ClientCustomers.OrderBy(t => t.CompanyName).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading tenants: {ex.Message}";
        }
    }

    private async Task LoadCustomers()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            customers = await context.Customers.OrderBy(c => c.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading customers: {ex.Message}";
        }
    }

    private async Task LoadPermissionGroups()
    {
        try
        {
            await using var context = await ContextFactory.CreateDbContextAsync();
            permissionGroups = await context.PermissionGroups.OrderBy(pg => pg.Name).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading permission groups: {ex.Message}";
        }
    }

    private async Task LoadUserPermissions()
    {
        try
        {
            isLoading = true;
            errorMessage = null;
            await using var context = await ContextFactory.CreateDbContextAsync();
            
            var query = context.UserPermissions.AsQueryable();
            
            if (!string.IsNullOrEmpty(selectedUserId) && Guid.TryParse(selectedUserId, out var userId))
            {
                query = query.Where(up => up.UserId == userId);
            }
            
            if (!string.IsNullOrEmpty(selectedTenantId) && Guid.TryParse(selectedTenantId, out var tenantId))
            {
                query = query.Where(up => up.ClientCustomerId == tenantId || 
                    (up.CustomerId.HasValue && customers.Any(c => c.Id == up.CustomerId.Value && c.ClientCustomerId == tenantId)));
            }
            
            userPermissions = await query.OrderBy(up => up.CreatedAt).ToListAsync();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading user permissions: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCustomersForTenant()
    {
        if (!string.IsNullOrEmpty(selectedTenantForCustomer) && Guid.TryParse(selectedTenantForCustomer, out var tenantId))
        {
            filteredCustomers = customers.Where(c => c.ClientCustomerId == tenantId).ToList();
        }
        else
        {
            filteredCustomers = new List<Customer>();
        }
    }

    private void OnScopeLevelChanged()
    {
        // Reset scope fields when changing scope level
        currentPermission.CustomerId = null;
        currentPermission.ClientCustomerId = null;
        selectedTenantForCustomer = "";
        filteredCustomers = new List<Customer>();
    }

    private void OnTenantChanged()
    {
        // Additional logic when tenant is selected
    }

    private void ShowAddDialog()
    {
        currentPermission = new UserPermission();
        scopeLevel = "customer";
        selectedTenantForCustomer = "";
        filteredCustomers = new List<Customer>();
        canRead = false;
        canCreate = false;
        canWrite = false;
        canDelete = false;
        isEditing = false;
        showDialog = true;
    }

    private void ShowEditDialog(UserPermission perm)
    {
        currentPermission = new UserPermission
        {
            Id = perm.Id,
            UserId = perm.UserId,
            CustomerId = perm.CustomerId,
            ClientCustomerId = perm.ClientCustomerId,
            PermissionGroupId = perm.PermissionGroupId,
            AllowedActions = perm.AllowedActions,
            Notes = perm.Notes
        };

        if (perm.CustomerId.HasValue)
        {
            scopeLevel = "customer";
            var customer = customers.FirstOrDefault(c => c.Id == perm.CustomerId.Value);
            if (customer != null)
            {
                selectedTenantForCustomer = customer.ClientCustomerId.ToString();
                LoadCustomersForTenant();
            }
        }
        else if (perm.ClientCustomerId.HasValue)
        {
            scopeLevel = "tenant";
        }
        else
        {
            scopeLevel = "global";
        }

        var flags = (PermissionFlags)perm.AllowedActions;
        canRead = flags.HasFlag(PermissionFlags.CanRead);
        canCreate = flags.HasFlag(PermissionFlags.CanCreate);
        canWrite = flags.HasFlag(PermissionFlags.CanWrite);
        canDelete = flags.HasFlag(PermissionFlags.CanDelete);

        isEditing = true;
        showDialog = true;
    }

    private void ShowDeleteDialog(UserPermission perm)
    {
        permissionToDelete = perm;
        showDeleteDialog = true;
    }

    private void CloseDialog()
    {
        showDialog = false;
        currentPermission = new UserPermission();
    }

    private void CloseDeleteDialog()
    {
        showDeleteDialog = false;
        permissionToDelete = null;
    }

    private async Task SavePermission()
    {
        if (currentPermission.UserId == Guid.Empty || 
            currentPermission.PermissionGroupId == Guid.Empty)
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        try
        {
            isSaving = true;
            
            // Calculate allowed actions based on checkboxes
            int allowedActions = 0;
            if (canRead) allowedActions |= (int)PermissionFlags.CanRead;
            if (canCreate) allowedActions |= (int)PermissionFlags.CanCreate;
            if (canWrite) allowedActions |= (int)PermissionFlags.CanWrite;
            if (canDelete) allowedActions |= (int)PermissionFlags.CanDelete;

            currentPermission.AllowedActions = allowedActions;

            // Set scope based on scopeLevel
            if (scopeLevel == "global")
            {
                currentPermission.CustomerId = null;
                currentPermission.ClientCustomerId = null;
            }
            else if (scopeLevel == "tenant")
            {
                currentPermission.CustomerId = null;
                // ClientCustomerId is already set
            }
            // For customer level, both CustomerId and its parent ClientCustomerId should be set

            await using var context = await ContextFactory.CreateDbContextAsync();

            if (isEditing)
            {
                var existing = await context.UserPermissions.FindAsync(currentPermission.Id);
                if (existing != null)
                {
                    existing.UserId = currentPermission.UserId;
                    existing.CustomerId = currentPermission.CustomerId;
                    existing.ClientCustomerId = currentPermission.ClientCustomerId;
                    existing.PermissionGroupId = currentPermission.PermissionGroupId;
                    existing.AllowedActions = currentPermission.AllowedActions;
                    existing.Notes = currentPermission.Notes;
                    existing.UpdatedAt = DateTime.UtcNow;
                }
            }
            else
            {
                currentPermission.Id = Guid.NewGuid();
                currentPermission.CreatedAt = DateTime.UtcNow;
                await context.UserPermissions.AddAsync(currentPermission);
            }

            await context.SaveChangesAsync();
            await LoadUserPermissions();
            CloseDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving user permission: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeletePermission()
    {
        if (permissionToDelete == null) return;

        try
        {
            isSaving = true;
            await using var context = await ContextFactory.CreateDbContextAsync();
            var perm = await context.UserPermissions.FindAsync(permissionToDelete.Id);
            if (perm != null)
            {
                context.UserPermissions.Remove(perm);
                await context.SaveChangesAsync();
                await LoadUserPermissions();
            }
            CloseDeleteDialog();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error deleting user permission: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }
}

